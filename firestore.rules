rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'hVp1p5UP9WQ8JTvngErmjVkrXcj1';
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileHasSubjects() {
      return profile().keys().hasAny(['subjects'])
             && profile().subjects is list
             && profile().subjects.size() > 0;
    }

    function profileSubjectAllows(subject) {
      return !profileHasSubjects() || profile().subjects.hasAny([subject]);
    }

    function profileGradeAllows(grade) {
      return profile().role != 'learner'
             || !profile().keys().hasAny(['grade'])
             || grade == profile().grade
             || grade == ('Grade ' + profile().grade);
    }

    function canAccessRegisteredResource(data) {
      return isAdmin()
             || (
               signedIn()
               && hasUserProfile()
               && data.keys().hasAll(['grade', 'subject'])
               && profileGradeAllows(data.grade)
               && profileSubjectAllows(data.subject)
             );
    }

    function userChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOwnChatAccessRequest() {
      return userChangedKeys().hasOnly(['chatStatus'])
             && request.resource.data.chatStatus == 'pending'
             && resource.data.chatStatus != 'verified';
    }

    function isOwnLimitedProfileEdit() {
      return userChangedKeys().hasOnly([
               'fullName', 'phone', 'school', 'grade', 'subjects',
               'profileEditYear', 'profileEditCount', 'profileEditedAt'
             ])
             && request.resource.data.fullName is string
             && request.resource.data.fullName.size() > 0
             && request.resource.data.fullName.size() <= 120
             && request.resource.data.school is string
             && request.resource.data.school.size() > 0
             && request.resource.data.school.size() <= 160
             && request.resource.data.profileEditYear is int
             && request.resource.data.profileEditCount is int
             && request.resource.data.profileEditCount >= 1
             && request.resource.data.profileEditCount <= 2
             && request.resource.data.profileEditedAt == request.time
             && (
               !resource.data.keys().hasAll(['profileEditYear', 'profileEditCount'])
               || request.resource.data.profileEditYear > resource.data.profileEditYear
               || (
                 request.resource.data.profileEditYear == resource.data.profileEditYear
                 && resource.data.profileEditCount < 2
                 && request.resource.data.profileEditCount == resource.data.profileEditCount + 1
               )
             );
    }

    // Public access to games and notes collections
    match /games/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /notes/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Activities require a signed-in profile that matches the activity grade and subject.
    match /activities/{document=**} {
      allow read: if canAccessRegisteredResource(resource.data);
      allow create, update: if canAccessRegisteredResource(request.resource.data)
                            && (
                              !request.resource.data.keys().hasAny(['uid'])
                              || request.resource.data.uid == request.auth.uid
                            )
                            && (
                              !request.resource.data.keys().hasAny(['userId'])
                              || request.resource.data.userId == request.auth.uid
                            );
      allow delete: if false;
    }

    // Registered users can create feedback under their own authenticated identity.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'userId', 'accountEmail', 'fullName', 'role',
                      'requestType', 'subject', 'message', 'createdAt'
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.accountEmail == request.auth.token.email
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.role in ['Learner', 'Teacher', 'Parent', 'Other']
                    && request.resource.data.requestType in [
                      'General Feedback', 'Report Broken Link', 'Request Presentation',
                      'Request Game', 'Request Activity', 'Request Learning Guide', 'Support Help'
                    ]
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Learning Forum messages require a verified profile and must match the registered grade/subject.
    match /messages/{messageId} {
      allow read: if signedIn()
                  && hasUserProfile()
                  && profile().chatStatus == 'verified'
                  && canAccessRegisteredResource(resource.data);

      allow create: if signedIn()
                    && hasUserProfile()
                    && profile().chatStatus == 'verified'
                    && request.resource.data.uid == request.auth.uid
                    && canAccessRegisteredResource(request.resource.data);

      allow update, delete: if false;
    }

    // Users collection rules
    match /users/{userId} {
      allow read, write: if isAdmin();

      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
                    && request.auth.uid == userId
                    && (isOwnChatAccessRequest() || isOwnLimitedProfileEdit());

      allow delete: if false;
    }

    // Admin fallback for any future collection; everyone else remains denied by default.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
